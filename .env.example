# Copy to .env.local and fill in. Never commit real secrets.

# --- Site -------------------------------------------------------------
# Public production URL (canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Set to "false" to block indexing (robots.txt). Vercel preview deploys are blocked automatically.
NEXT_PUBLIC_ALLOW_INDEXING=true
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Analytics / Google Ads (public IDs) --------------------------------
# If GTM is set, configure GA4 + Ads tags inside GTM (gtag.js is then not loaded).
NEXT_PUBLIC_GTM_ID=
# Used only when GTM is NOT set:
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_QUOTE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_DEMO_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_BROCHURE_LABEL=
# "true" to send email/phone for Ads enhanced conversions (review consent/privacy first)
NEXT_PUBLIC_ADS_ENHANCED_CONVERSIONS=false
# Consent Mode v2 default: "granted" or "denied" (use "denied" + a CMP for EU/UK traffic)
NEXT_PUBLIC_CONSENT_DEFAULT=granted

# --- Enquiry delivery (server-only secrets) -----------------------------
# At least one adapter is required in production, otherwise submissions return an error
# (in development, enquiries are logged to the terminal instead).
# Generic JSON webhook: CRM, Zapier/Make, Power Automate, your own API
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
# Email via Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=sales@example.com
ENQUIRY_EMAIL_FROM=Website Enquiries <enquiries@example.com>

# --- Optional CAPTCHA -------------------------------------------------------
# Client (reCAPTCHA v3 site key, public)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server: "recaptcha" or "turnstile"
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
